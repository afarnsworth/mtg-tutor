{
  "name": "mtg-tutor",
  "private": true,
  "version": "0.1.0",
  "description": "Fast, offline Magic: The Gathering card lookup PWA",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "data": "node scripts/build-data.ts",
    "dev": "vite",
    "build": "vite build && node scripts/postbuild.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
